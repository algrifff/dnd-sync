{
  "name": "compendium-ai",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "dev": "bun scripts/gate.ts --pool dev --cost-mb 4500 --cwd server -- bun run server.ts",
    "test": "bun scripts/gate.ts --cost-mb 1500 -- bun test",
    "test:changed": "bun scripts/gate.ts --cost-mb 1500 -- bun test --changed=main",
    "typecheck": "bun scripts/gate.ts --cost-mb 1500 -- bun run raw:typecheck",
    "lint": "bun scripts/gate.ts --cost-mb 1500 -- bun run raw:lint",
    "raw:typecheck": "bun --filter '*' typecheck",
    "raw:lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.4",
    "@types/bun": "^1.1.10",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.170"
  }
}
